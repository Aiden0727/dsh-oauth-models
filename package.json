{
  "name": "dsh-oauth-models",
  "version": "0.6.2",
  "description": "OpenAI Codex and Anthropic OAuth model providers for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "docs/images/*.png",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "verify": "npm run typecheck && node --check client.js && npm test && npm pack --dry-run",
    "prepare": "npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "oauth",
    "openai-codex",
    "anthropic"
  ],
  "license": "MIT",
  "author": "Aiden0727",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aiden0727/dsh-oauth-models.git"
  },
  "homepage": "https://github.com/Aiden0727/dsh-oauth-models#readme",
  "bugs": {
    "url": "https://github.com/Aiden0727/dsh-oauth-models/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@earendil-works/pi-ai": "0.82.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@types/node": "^22.17.1",
    "typescript": "^5.9.2"
  }
}
